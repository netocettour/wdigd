# Firma la cookie de sesión. Obligatoria en producción.
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Base de datos. Opcional en local: sin esta variable la app usa SQLite en ./wdigd.db.
# Con Docker Compose se setea automáticamente al Postgres del stack.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# true en producción (cookie de sesión sólo por HTTPS).
SECURE_COOKIES=false

# Integración opcional con Google Calendar. Ver docs/google-cloud-setup.md.
# Sin estas variables la feature queda deshabilitada y no aparece en Ajustes.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
